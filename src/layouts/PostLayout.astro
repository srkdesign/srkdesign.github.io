---
// Styles
import "../styles/_syntaxHighlight.css";
import "../styles/_callouts.css";

import i18n from "i18next";
import { Image } from "astro:assets";

// Components
import Layout from "./Layout.astro";
// import CategoriesList from "../components/Post/CategoriesList.astro";
// import TableOfContents from "../components/Post/TableOfContents.astro";
import TableOfContents from "../components/Post/TableOfContents.jsx";

// Functions
import FormatDate from "../utils/FormatDate";
import AnimatedLayout from "./AnimatedLayout";
import type { HeadingProps } from "../types";
import LocalGraph from "@/components/Post/LocalGraph.jsx";
import { buildGraph } from "@/lib/buildGraph";
import { getLocalGraph } from "@/lib/getLocalGraph.js";
const {
  title,
  description,
  heroImage,
  pubDate,
  updatedDate,
  headings,
  locale,
  tags,
} = Astro.props;

const filteredHeadings = headings.filter(
  (heading: HeadingProps) => heading.depth < 3,
);

import path from "path";
import CenteredSidebar from "@/components/Post/CenteredSidebar.jsx";

const graph = buildGraph(
  path.join(process.cwd(), `src/content/blog/${locale}`),
);

const currentSlug = Astro.params.slug ?? "";

const graphData = getLocalGraph(graph, currentSlug);

// console.log(graphData);
---

<Layout title={title} description={description} locale={locale}>
  <AnimatedLayout client:only="react">
    <section class="lg:mb-24 mb-10">
      <div class="lg:px-24 px-8 lg:mb-16 mb-10">
        <a
          href="/blog/"
          class="no-underline font-normal flex mb-8 opacity-80 w-fit text-lg"
          >← {i18n.t("blog.go_back")}</a
        >

        <h1 class="text-[clamp(2rem,0.8rem+6vw,8rem)] leading-none text-pretty">
          {title}
        </h1>
      </div>
      <Image
        src={heroImage}
        alt={title}
        format="webp"
        width="1920"
        height="1080"
        class="w-full h-auto"
      />
    </section>

    <section
      class="flex flex-col md:grid grid-cols-[minmax(0,12rem)_1fr_minmax(0,12rem)] px-8 lg:px-24"
    >
      <aside></aside>
      <article class="md:mx-auto mb-16 md:mb-0">
        <div class="2xl:max-w-[81ch] lg:max-w-[61ch]">
          <div class="flex flex-col gap-16">
            <div
              class="prose prose-neutral prose-invert prose-xl prose-medium prose-headings:font-medium prose-headings:text-pretty prose-strong:font-medium prose-blockquote:not-italic prose-blockquote:[quotes:none] prose-code:after:content-none prose-code:before:content-none prose-img:rounded-lg prose-img:w-full prose-table:block prose-table:overflow-x-auto"
            >
              <slot />
            </div>
            <ul class="flex list-none m-0 p-0 *:p-0">
              {
                tags
                  ? tags.map((tag: string) => (
                      <li>
                        <a
                          href={`/tags/${tag}`}
                          class="uppercase text-sm border border-white/20 px-4 py-2 rounded-full text-nowrap"
                        >
                          {i18n.t(`blog.tags.${tag}`)}
                        </a>
                      </li>
                    ))
                  : ""
              }
            </ul>
            <ul class="list-none m-0 p-0 flex flex-col gap-2 text-neutral-400">
              <li class="p-0 m-0">
                <p class="p-0 m-0">
                  {i18n.t("blog.published")}: {
                    FormatDate(pubDate, i18n.language)
                  }
                </p>
              </li>
              {
                updatedDate ? (
                  <li class="p-0 m-0">
                    <p class="p-0 m-0">
                      {i18n.t("blog.updated")}:{" "}
                      {FormatDate(updatedDate, i18n.language)}
                    </p>
                  </li>
                ) : (
                  ""
                )
              }
            </ul>
          </div>
        </div>
      </article>
      <CenteredSidebar client:only="react">
        <LocalGraph
          graphData={graphData}
          currentId={currentSlug}
          client:only="react"
        />
        <TableOfContents headings={filteredHeadings} client:only="react" />
      </CenteredSidebar>
    </section>
  </AnimatedLayout>
</Layout>
